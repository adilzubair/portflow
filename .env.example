# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Twelve Data — only required for UAE/DFM stock quotes
# (free key: https://twelvedata.com/pricing)
TWELVE_DATA_API_KEY=your_twelve_data_api_key

# OpenRouter screenshot import
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free
# Optional if you want a pinned free vision model instead of the free router:
# OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_APP_NAME=Portflow
OPENROUTER_APP_URL=http://localhost:3000

# Screenshot import provider selection: auto | openai | openrouter
PORTFOLIO_IMPORT_PROVIDER=auto

# OpenAI screenshot import
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# API rate limits
RATE_LIMIT_IP_SALT=change_me_to_a_random_secret
RATE_LIMIT_AI_ACCOUNT_PER_HOUR=20
RATE_LIMIT_AI_IP_PER_HOUR=40
RATE_LIMIT_HOLDINGS_READ_ACCOUNT_PER_MINUTE=180
RATE_LIMIT_HOLDINGS_READ_IP_PER_MINUTE=360
RATE_LIMIT_HOLDINGS_WRITE_ACCOUNT_PER_MINUTE=60
RATE_LIMIT_HOLDINGS_WRITE_IP_PER_MINUTE=120
RATE_LIMIT_PRICE_REFRESH_ACCOUNT_PER_HOUR=60
RATE_LIMIT_PRICE_REFRESH_IP_PER_HOUR=120
RATE_LIMIT_PRICE_CHECK_ACCOUNT_PER_MINUTE=60
RATE_LIMIT_PRICE_CHECK_IP_PER_MINUTE=180
