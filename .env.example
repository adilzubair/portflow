# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Twelve Data (free key: https://twelvedata.com/pricing)
TWELVE_DATA_API_KEY=your_twelve_data_api_key

# Alpha Vantage (free key: https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# OpenRouter screenshot import
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free
# Optional if you want a pinned free vision model instead of the free router:
# OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_APP_NAME=Portflow
OPENROUTER_APP_URL=http://localhost:3000
